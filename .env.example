# Copia este archivo a .env (ignorado por git) y ajusta los valores.
# Una sola URI sirve para las dos apps; cada una fija su propio dbName en el código.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true

# Seguridad de `api` (no la usa `notifications`).
# Genera el par con `npm run keys:generate` y pega las dos líneas aquí.
# PEM RSA >= 2048 bits; los saltos de línea pueden ir escapados como \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Secreto compartido del HMAC del webhook de pagos (mínimo 32 caracteres).
# Valor de ejemplo falso: genera uno propio, p. ej. `openssl rand -hex 32`.
PAYMENTS_WEBHOOK_SECRET=cambia-este-secreto-de-ejemplo-por-uno-propio-0000
# Orígenes CORS permitidos, separados por comas. Vacío = sin orígenes cruzados.
CORS_ORIGINS=
# `production` desactiva Swagger.
NODE_ENV=development

# Solo para `npm run seed:admin` (crea el primer ADMIN); `api` no las lee.
# No las dejes en este archivo: pásalas al ejecutar el comando, p. ej.
#   ADMIN_EMAIL=admin@correo.com ADMIN_PASSWORD='...' npm run seed:admin
